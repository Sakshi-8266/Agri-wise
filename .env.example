# ==============================================================
# AgriWise Full-Stack Environment Variables
# ==============================================================

# --------------------------------------------------------------
# 1. BACKEND DEPLOYMENT (Render / Self-Hosted)
# --------------------------------------------------------------
PORT=8000
SECRET_KEY=agriwise-secret-key-production-ready-2026-super-secure

# Database Connection:
# For SQLite (default / local):
DATABASE_URL=sqlite:///./agriwise.db
# For PostgreSQL (e.g. Render Managed PostgreSQL):
# DATABASE_URL=postgresql://username:password@hostname:5432/agriwise

# CORS Allowed Origins:
# Comma-separated domains that can communicate with your backend.
# (Note: All *.vercel.app domains are automatically allowed via regex)
ALLOWED_ORIGINS=http://localhost:5173,https://your-agriwise-frontend.vercel.app

# ElevenLabs AI Voice Assistant & Agents Platform
# Get your API key and Agent ID from: https://elevenlabs.io/app/conversational-ai
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --------------------------------------------------------------
# 2. FRONTEND DEPLOYMENT (Vercel)
# --------------------------------------------------------------
# Set this in Vercel Project Settings > Environment Variables:
# Provide the public HTTPS URL of your deployed Render backend (NO trailing slash):
VITE_API_BASE_URL=https://your-agriwise-backend.onrender.com
